# Example systemd service unit for the Heimdal Kerberos password change
# service.
#
# This file is not installed.  To use it, copy it to
# /etc/systemd/system/kpasswdd.service, fix the path in ExecStart= to
# match your installation (the default is for --prefix=/usr/heimdal),
# and adjust as needed.  See "SERVICE MANAGER INTEGRATION" in
# kpasswdd(8).
#
# This unit is socket-activated by kpasswdd.socket (see
# kpasswdd.socket.example). To have kpasswdd create its own sockets
# instead, remove the Requires= and After= lines that refer to
# kpasswdd.socket and the Also= line.

[Unit]
Description=Heimdal Kerberos password change service
Documentation=man:kpasswdd(8)
Requires=kpasswdd.socket
After=network.target kpasswdd.socket

[Service]
# kpasswdd reports readiness and status via sd_notify(3).
Type=notify
ExecStart=/usr/heimdal/libexec/kpasswdd
# Alternatively, rely on kpasswdd not exiting until its daemon child is
# ready:
#Type=forking
#ExecStart=/usr/heimdal/libexec/kpasswdd --detach
#PIDFile=/run/kpasswdd.pid
# ...and also accept its STATUS= notifications:
#NotifyAccess=exec
Restart=on-failure
# With socket activation kpasswdd needs no network access of its own, so
# it can be run in a private network namespace.  This also prevents
# outbound connections (e.g., DNS lookups, or LDAP for an LDAP HDB
# backend), so check that your configuration does not need any first.
#PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
Also=kpasswdd.socket
