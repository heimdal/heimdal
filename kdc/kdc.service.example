# Example systemd service unit for the Heimdal Kerberos KDC.
#
# This file is not installed.  To use it, copy it to
# /etc/systemd/system/kdc.service, fix the path in ExecStart= to match
# your installation (the default is for --prefix=/usr/heimdal), and
# adjust as needed.  See "SERVICE MANAGER INTEGRATION" in kdc(8).
#
# This unit is socket-activated by kdc.socket (see kdc.socket.example).
# To have kdc create its own sockets instead, remove the Requires= and
# After= lines that refer to kdc.socket and the Also= line.

[Unit]
Description=Heimdal Kerberos KDC
Documentation=man:kdc(8)
Requires=kdc.socket
After=network.target kdc.socket

[Service]
# kdc reports readiness and status via sd_notify(3).
Type=notify
ExecStart=/usr/heimdal/libexec/kdc
# Alternatively, rely on kdc not exiting until its daemon child is
# ready:
#Type=forking
#ExecStart=/usr/heimdal/libexec/kdc --detach
#PIDFile=/run/kdc.pid
# ...and also accept its STATUS= notifications:
#NotifyAccess=exec
Restart=on-failure
# With socket activation kdc needs no network access of its own, so it
# can be run in a private network namespace.  This also prevents
# outbound connections (e.g., DNS lookups, or LDAP for an LDAP HDB
# backend), so check that your configuration does not need any first.
#PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
Also=kdc.socket
